generator client {
  provider = "prisma-client-js"
  engineType = "binary"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

// Enums (Converted to Strings for SQLite compatibility)
// TicketStatus: ISSUED, CALLED, ATTENDING, DONE, NO_SHOW, CANCELLED
// PriorityLevel: TOTAL, SENIOR, NORMAL
// Group: ESTADO, MUNICIPIO
// Role: ADMIN, SUPERVISOR, ATENDENTE, GUICHE, MEDIA_MANAGER

// Models

model User {
  id        Int      @id @default(autoincrement())
  username  String   @unique
  password  String   // Hashed
  name      String
  role      String   @default("ATENDENTE") // Role
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  
  // Auditing
  logs      AuditLog[]
}

model TicketType {
  id          Int           @id @default(autoincrement())
  code        String        @unique // AE, EP, E...
  description String
  priority    String        // PriorityLevel
  group       String        // Group
  active      Boolean       @default(true)
  
  tickets     Ticket[]
  dailyCounts DailyCounter[]
}

model DailyCounter {
  id           Int        @id @default(autoincrement())
  date         String     // YYYY-MM-DD
  ticketTypeId Int
  count        Int        @default(0)
  
  ticketType   TicketType @relation(fields: [ticketTypeId], references: [id])
  
  @@unique([date, ticketTypeId])
}

model Ticket {
  id           Int          @id @default(autoincrement())
  number       Int          // Sequence number
  code         String       // Full code (e.g., AE-001)
  
  status       String       @default("ISSUED") // TicketStatus
  
  issuedAt     DateTime     @default(now())
  calledAt     DateTime?
  finishedAt   DateTime?
  
  ticketTypeId Int
  counterId    Int?         // Which counter called it
  
  ticketType   TicketType   @relation(fields: [ticketTypeId], references: [id])
  counter      Counter?     @relation(fields: [counterId], references: [id])
}

model Counter {
  id          Int     @id @default(autoincrement())
  number      Int     @unique // 1..12
  group       String? // Group (If null, can be hybrid or unassigned)
  isHybrid    Boolean @default(false)
  
  tickets     Ticket[]
}

model AdCampaign {
  id        Int      @id @default(autoincrement())
  name      String
  startDate DateTime
  endDate   DateTime
  active    Boolean  @default(true)
  
  medias    AdMedia[]
}

model AdMedia {
  id          Int        @id @default(autoincrement())
  campaignId  Int
  type        String     // IMAGE, VIDEO
  path        String     // Storage path
  duration    Int        // Seconds
  description String?
  
  campaign    AdCampaign @relation(fields: [campaignId], references: [id])
  playLogs    AdPlayLog[]
}

model AdPlayLog {
  id        Int      @id @default(autoincrement())
  mediaId   Int
  playedAt  DateTime @default(now())
  duration  Int
  
  media     AdMedia  @relation(fields: [mediaId], references: [id])
}

model AuditLog {
  id        Int      @id @default(autoincrement())
  userId    Int?
  action    String
  details   String?
  timestamp DateTime @default(now())
  
  user      User?    @relation(fields: [userId], references: [id])
}

model Config {
  key   String @id
  value String
}
